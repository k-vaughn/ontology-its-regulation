// Diagram for PermitRequiredCondition
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		Condition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Condition</TD></TR></TABLE>> URL="../Condition" margin=0]
	}
	PermitRequiredCondition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitRequiredCondition</TD></TR><TR><TD ALIGN="LEFT">requiredPermitIdentifier : xsd:string [1]</TD></TR></TABLE>> URL="../PermitRequiredCondition" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		cdm2_Organization [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm2:Organization</TD></TR></TABLE>> URL="https://w3id.org/citydata/part2/v1/Organization" margin=0]
		PermitDesignationCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDesignationCode</TD></TR></TABLE>> URL="../PermitDesignationCode" margin=0]
		PermitDisplayTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDisplayTypeCode</TD></TR></TABLE>> URL="../PermitDisplayTypeCode" margin=0]
		PermitGrantorTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitGrantorTypeCode</TD></TR></TABLE>> URL="../PermitGrantorTypeCode" margin=0]
	}
	PermitRequiredCondition -> Condition [arrowhead=onormal style=solid]
	PermitRequiredCondition -> Invis [style=invis]
	Invis -> cdm2_Organization [style=invis]
	cdm2_Organization -> PermitDesignationCode [style=invis]
	PermitDesignationCode -> PermitDisplayTypeCode [style=invis]
	PermitDisplayTypeCode -> PermitGrantorTypeCode [style=invis]
	PermitDesignationCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDesignationCode</TD></TR></TABLE>> URL="../PermitDesignationCode" margin=0]
	PermitRequiredCondition -> PermitDesignationCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">requiredDesignation</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitDisplayTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDisplayTypeCode</TD></TR></TABLE>> URL="../PermitDisplayTypeCode" margin=0]
	PermitRequiredCondition -> PermitDisplayTypeCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">requiredDisplayType</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	cdm2_Organization [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm2:Organization</TD></TR></TABLE>> URL="https://w3id.org/citydata/part2/v1/Organization" margin=0]
	PermitRequiredCondition -> cdm2_Organization [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">requiredGrantor</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitGrantorTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitGrantorTypeCode</TD></TR></TABLE>> URL="../PermitGrantorTypeCode" margin=0]
	PermitRequiredCondition -> PermitGrantorTypeCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">requiredGrantorType</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
}
