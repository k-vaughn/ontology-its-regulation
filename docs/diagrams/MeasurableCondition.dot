// Diagram for MeasurableCondition
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		Condition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Condition</TD></TR></TABLE>> URL="../Condition" margin=0]
	}
	MeasurableCondition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MeasurableCondition</TD></TR></TABLE>> URL="../MeasurableCondition" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		cdm1_Measure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm1:Measure</TD></TR></TABLE>> URL="https://w3id.org/citydata/part1/v1/Measure" margin=0]
		"its-core_ComparisonOperatorCode" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-core:ComparisonOperatorCode</TD></TR></TABLE>> URL="https://w3id.org/itsdata/core/v1/ComparisonOperatorCode" margin=0]
		MeasurableConditionCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MeasurableConditionCode</TD></TR></TABLE>> URL="../MeasurableConditionCode" margin=0]
	}
	MeasurableCondition -> Condition [arrowhead=onormal style=solid]
	MeasurableCondition -> Invis [style=invis]
	Invis -> cdm1_Measure [style=invis]
	cdm1_Measure -> "its-core_ComparisonOperatorCode" [style=invis]
	"its-core_ComparisonOperatorCode" -> MeasurableConditionCode [style=invis]
	MeasurableConditionCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">MeasurableConditionCode</TD></TR></TABLE>> URL="../MeasurableConditionCode" margin=0]
	MeasurableCondition -> MeasurableConditionCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">forMeasurableCondition</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
	"its-core_ComparisonOperatorCode" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-core:ComparisonOperatorCode</TD></TR></TABLE>> URL="https://w3id.org/itsdata/core/v1/ComparisonOperatorCode" margin=0]
	MeasurableCondition -> "its-core_ComparisonOperatorCode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">comparisonOperator</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
	cdm1_Measure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm1:Measure</TD></TR></TABLE>> URL="https://w3id.org/citydata/part1/v1/Measure" margin=0]
	MeasurableCondition -> cdm1_Measure [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">valueToCompare</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
}
